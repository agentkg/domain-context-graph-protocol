{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dcg.dev/schema/stack.schema.json",
  "title": "DCG Stack Manifest",
  "description": "Composition manifest for multi-layer DCG knowledge stacks.",
  "type": "object",
  "required": ["stack", "layers"],
  "additionalProperties": false,
  "properties": {
    "stack": { "type": "string" },
    "strict": { "type": "boolean", "default": false },
    "join_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.5,
      "description": "Global default threshold for fuzzy (~>) join rules"
    },
    "layers": {
      "type": "array",
      "items": { "$ref": "#/$defs/layer_entry" },
      "minItems": 1
    },
    "joins": {
      "type": "array",
      "items": { "$ref": "#/$defs/join_rule" }
    }
  },
  "$defs": {
    "layer_entry": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {
        "name": { "type": "string" },
        "source": { "type": "string" },
        "extends": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "join_rule": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_]*( [a-z][a-z0-9_]*)*$": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^([a-z][a-z0-9_-]*\\.)?[A-Z][A-Za-z0-9_-]*\\.[a-z][a-z0-9_]* [~-]> ([a-z][a-z0-9_-]*\\.)?[A-Z][A-Za-z0-9_-]*\\.[a-z][a-z0-9_]*$"
            },
            {
              "type": "object",
              "required": ["rule"],
              "properties": {
                "rule": {
                  "type": "string",
                  "pattern": "^([a-z][a-z0-9_-]*\\.)?[A-Z][A-Za-z0-9_-]*\\.[a-z][a-z0-9_]* [~-]> ([a-z][a-z0-9_-]*\\.)?[A-Z][A-Za-z0-9_-]*\\.[a-z][a-z0-9_]*$"
                },
                "threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "matcher": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
